foreach(seed 0 130 18446744073709551615)
    execute_process(COMMAND "${PROBE}" ${EXTRA} --probe --seed "${seed}" RESULT_VARIABLE a OUTPUT_VARIABLE original)
    execute_process(COMMAND "${PROBE}" ${EXTRA} --probe --seed "${seed}" --reverse RESULT_VARIABLE b OUTPUT_VARIABLE reversed)
    execute_process(COMMAND "${PROBE}" ${EXTRA} --probe --seed "${seed}" --reverse --threads RESULT_VARIABLE c OUTPUT_VARIABLE threaded)
    if(NOT a EQUAL 0 OR NOT b EQUAL 0 OR NOT c EQUAL 0 OR NOT original STREQUAL reversed OR NOT original STREQUAL threaded)
        message(FATAL_ERROR "Generator reproducibility failed for seed ${seed}")
    endif()
endforeach()
