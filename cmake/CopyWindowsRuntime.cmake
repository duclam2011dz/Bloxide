cmake_minimum_required(VERSION 3.25)
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
if(OBJDUMP)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${OBJDUMP}")
endif()
file(TO_CMAKE_PATH "$ENV{SystemRoot}" windows_root)
if(NOT windows_root)
    message(FATAL_ERROR "SystemRoot is required for Windows runtime discovery")
endif()
set(system_regex "^")
string(LENGTH "${windows_root}" root_length)
math(EXPR last "${root_length}-1")
foreach(index RANGE 0 ${last})
    string(SUBSTRING "${windows_root}" ${index} 1 letter)
    if(letter MATCHES "[A-Za-z]")
        string(TOLOWER "${letter}" lower)
        string(TOUPPER "${letter}" upper)
        string(APPEND system_regex "[${lower}${upper}]")
    elseif(letter STREQUAL "/")
        string(APPEND system_regex "[/\\\\]")
    elseif(letter MATCHES "[0-9:_ -]")
        string(APPEND system_regex "${letter}")
    else()
        string(APPEND system_regex "\\" "${letter}")
    endif()
endforeach()
string(APPEND system_regex "[/\\\\].*")
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${EXECUTABLE}" DIRECTORIES ${RUNTIME_HINTS}
    RESOLVED_DEPENDENCIES_VAR runtime UNRESOLVED_DEPENDENCIES_VAR missing
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    POST_EXCLUDE_REGEXES "${system_regex}")
if(missing)
    message(FATAL_ERROR "Unresolved runtime dependencies for ${EXECUTABLE}: ${missing}")
endif()
foreach(dependency IN LISTS runtime)
    get_filename_component(name "${dependency}" NAME)
    file(COPY_FILE "${dependency}" "${OUTPUT}/${name}" ONLY_IF_DIFFERENT)
endforeach()
